<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store (Lite) build, every nested executable: Electron helpers and the bundled runtime (python3.12, ffmpeg,
  ffprobe, *.so, *.dylib). Exactly these two keys: the child runs in the app's sandbox (Apple, "Embedding a helper
  tool in a sandboxed app"); any other entitlement makes a sandboxed child crash at launch.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
