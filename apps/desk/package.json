{
  "name": "video-studio-desk",
  "productName": "Reelfold",
  "version": "0.2.3",
  "private": true,
  "description": "Reelfold (千剪): one recording, folded out into every cut for every platform. Desktop app on the open-source Reelfold engine.",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --dir",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run && npm run test:engine",
    "test:unit": "vitest run",
    "test:engine": "python3 -m unittest discover -s engine/tests",
    "test:e2e": "npm run build && playwright test",
    "release:mac": "bash scripts/release-mac.sh",
    "release:mas": "bash scripts/release-mas.sh",
    "mas:local": "bash scripts/mas-local.sh",
    "dist:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never -c.mac.notarize=false",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "dist:appx": "npm run build && electron-builder --config electron-builder.config.cjs --win appx --x64 --publish never",
    "runtime": "node scripts/runtime/bundle.mjs",
    "runtime:lock": "node scripts/runtime/lock.mjs && node scripts/runtime/assets-lock.mjs",
    "test:packaged": "playwright test -c playwright.packaged.config.ts",
    "postinstall": "node scripts/fixPty.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.52.0",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyziyun/reelfold.git",
    "directory": "apps/desk"
  },
  "author": {
    "name": "zyziyun"
  },
  "homepage": "https://reelfold.com",
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
