---
// FAQ as native <details>; the same array feeds the FAQPage JSON-LD (Seo.astro), so the visible text and the
// structured data always match.
import { heading } from '../lib/zhHeading';
import type { Lang } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang; kicker: string; title: string; items: { q: string; a: string }[]; id?: string }
const { lang, kicker, title, items, id = 'faq' } = Astro.props;
---
<section class="wrap" id={id} aria-labelledby={`${id}-h`}>
  <div class="faq">
    <div><p class="kick">{kicker}</p><h2 id={`${id}-h`} set:html={heading(title, lang)} /></div>
    <div class="qa">
      {items.map((x, i) => (
        <details open={i === 0}>
          <summary><h3>{x.q}</h3><Icon name="plus" class="plus" /></summary>
          <p>{x.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
