---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import Hero from './home/Hero.astro';
import Steps from './home/Steps.astro';
import Audiences from './home/Audiences.astro';
import Batch from './home/Batch.astro';
import Platforms from './home/Platforms.astro';
import ThreeUp from './home/ThreeUp.astro';
import CreateTeaser from './home/CreateTeaser.astro';
import OpenSource from './home/OpenSource.astro';
import Faq from './Faq.astro';
import FinalCta from './home/FinalCta.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<Hero {lang} />
<Steps {lang} />
<Audiences {lang} />
<Batch {lang} />
<Platforms {lang} />
<ThreeUp {lang} />
<CreateTeaser {lang} />
<OpenSource {lang} />
<Faq {lang} kicker={c.faq.k} title={c.faq.t} items={c.faq.items} />
<FinalCta {lang} title={c.final.t} />
