---
import Pic from './Pic.astro';
import Cta from './Cta.astro';
import { SITE } from '../config';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);

const SHEETS: Record<string, { w: number; h: number }> = {
  'longform-slices': { w: 1600, h: 712 },
  talkinghead: { w: 1600, h: 754 },
  'explainer-vertical': { w: 1600, h: 996 },
};
const [wide, ...pair] = c.proof.sheets;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 id="hero-title">{c.hero.titleA}<br /><mark>{c.hero.titleB}</mark></h1>
      <p class="lede">{c.hero.sub}</p>
      <Cta lang={lang} />
      <ul class="ticks">
        {c.hero.points.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="hero-visual" aria-hidden="false">
      <div class="phones">
        {[1, 2, 5].map((n, i) => (
          <figure class={`phone phone-${i + 1}`}>
            <Pic name={`frame-${n}`} w={196} h={256} alt={c.hero.frameAlts[i]} eager />
          </figure>
        ))}
      </div>
      <span class="sticker s-a">{c.hero.stickerA}</span>
      <span class="sticker s-b"><span class="dot dot-green" aria-hidden="true"></span>{c.hero.stickerB}</span>
      <span class="sticker s-c">{c.hero.stickerC}</span>
    </div>
  </div>
</section>

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <p class="kicker">{c.how.kicker}</p>
    <h2 id="how-title">{c.how.title}</h2>
    <ol class="steps">
      {c.how.steps.map((s, i) => (
        <li class="card step">
          <span class="step-num" aria-hidden="true">{pad(i + 1)}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="platforms">
      <span class="muted small">{c.how.platformsLabel}</span>
      <ul class="chips">
        {c.how.platforms.map((x) => <li class="chip">{x}</li>)}
      </ul>
    </div>
  </div>
</section>

<section id="uses" class="section section-paper" aria-labelledby="uses-title">
  <div class="wrap">
    <p class="kicker">{c.uses.kicker}</p>
    <h2 id="uses-title">{c.uses.title}</h2>
    <p class="lede">{c.uses.lede}</p>
    <ul class="grid-3">
      {c.uses.items.map((u) => (
        <li class="card">
          <h3>{u.title}</h3>
          <p>{u.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="app" class="section" aria-labelledby="app-title">
  <div class="wrap split">
    <div>
      <p class="kicker">{c.app.kicker}</p>
      <h2 id="app-title">{c.app.title}</h2>
      <p class="lede">{c.app.lede}</p>
      <Cta lang={lang} />
      <p class="small muted">{c.app.note} {c.cta.windows}.</p>
    </div>
    <figure class="board" aria-label={c.app.board.caption}>
      <div class="board-cols">
        {c.app.board.cols.map((col, i) => (
          <div class="board-col">
            <span class="board-head">{col}</span>
            <div class="board-card">
              <span class="thumb" style={`background-image:url(/img/frame-${(i % 3) === 0 ? 2 : (i % 3) === 1 ? 1 : 5}.webp)`}></span>
              <span class="board-title">{c.app.board.cards[i]}</span>
              {i === 2 ? (
                <span class="pill pill-red"><span class="dot dot-red" aria-hidden="true"></span>{c.app.board.red}</span>
              ) : i >= 3 ? (
                <span class="pill"><span class="dot dot-green" aria-hidden="true"></span>{c.app.board.green}</span>
              ) : null}
            </div>
          </div>
        ))}
      </div>
      <figcaption class="small muted">{c.app.board.caption}</figcaption>
    </figure>
  </div>
</section>

<section id="proof" class="section section-paper" aria-labelledby="proof-title">
  <div class="wrap">
    <p class="kicker">{c.proof.kicker}</p>
    <h2 id="proof-title">{c.proof.title}</h2>
    <p class="lede">{c.proof.lede}</p>
    <dl class="stats">
      {c.proof.stats.map((s) => (
        <div class="card stat">
          <dt>{s.label}</dt>
          <dd class="stat-value">{s.value}</dd>
          <dd class="stat-note">{s.note}</dd>
        </div>
      ))}
    </dl>
    <div class="card caveats">
      <h3>{c.proof.caveatsTitle}</h3>
      <ul>
        {c.proof.caveats.map((x) => <li>{x}</li>)}
      </ul>
    </div>

    <figure class="strip">
      <ul class="frames">
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <li><Pic name={`frame-${n}`} w={196} h={256} alt={c.proof.stripAlts[n - 1]} /></li>
        ))}
      </ul>
      <figcaption class="small muted">{c.proof.stripCaption}</figcaption>
    </figure>

    <figure class="sheet sheet-wide">
      <Pic name={wide.img} widths={[800, 1600]} w={SHEETS[wide.img].w} h={SHEETS[wide.img].h} alt={wide.alt} sizes="(min-width: 1180px) 1120px, 100vw" />
      <figcaption class="small muted">{wide.caption}</figcaption>
    </figure>
    <div class="sheet-pair">
      {pair.map((s) => (
        <figure class="sheet">
          <Pic name={s.img} widths={[800, 1600]} w={SHEETS[s.img].w} h={SHEETS[s.img].h} alt={s.alt} sizes="(min-width: 900px) 560px, 100vw" />
          <figcaption class="small muted">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="deliverables" class="section" aria-labelledby="deliv-title">
  <div class="wrap">
    <p class="kicker">{c.deliverables.kicker}</p>
    <h2 id="deliv-title">{c.deliverables.title}</h2>
    <ul class="grid-3">
      {c.deliverables.items.map((d) => (
        <li class="card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="local" class="section section-accent" aria-labelledby="local-title">
  <div class="wrap">
    <p class="kicker">{c.local.kicker}</p>
    <h2 id="local-title">{c.local.title}</h2>
    <ul class="grid-3">
      {c.local.items.map((d) => (
        <li class="card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="create" class="section" aria-labelledby="create-title">
  <div class="wrap">
    <div class="card create">
      <p class="kicker">{c.create.kicker} <span class="badge">{c.create.badge}</span></p>
      <h2 id="create-title">{c.create.title}</h2>
      <p class="lede">{c.create.body}</p>
    </div>
  </div>
</section>

<section id="oss" class="section section-paper" aria-labelledby="oss-title">
  <div class="wrap split oss">
    <div>
      <p class="kicker">{c.oss.kicker}</p>
      <h2 id="oss-title">{c.oss.title}</h2>
      <p class="lede">{c.oss.lede}</p>
      <p class="small muted">{c.oss.tested}</p>
      <a class="btn btn-ghost" href={SITE.githubUrl} rel="noopener">{c.oss.button} · {SITE.githubUrl.replace(/^https:\/\//, '')}</a>
    </div>
    <div class="code-stack">
      <div>
        <p class="code-label">{c.oss.skillLabel}</p>
        <pre class="code" aria-label={c.oss.skillLabel}><code><span class="muted"># Claude Code skill (video-studio) · MIT</span>
git clone {SITE.githubUrl} \
  ~/.claude/skills/video-studio
~/.claude/skills/video-studio/install.sh</code></pre>
      </div>
      <div>
        <p class="code-label">{c.oss.sourceLabel}</p>
        <pre class="code" aria-label={c.oss.sourceLabel}><code><span class="muted"># macOS (Apple Silicon), Node 22+, Python 3.10+, ffmpeg</span>
git clone {SITE.githubUrl} && cd reelfold
./install.sh && npm install
npm run desk</code></pre>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="wrap narrow">
    <p class="kicker">{c.faq.kicker}</p>
    <h2 id="faq-title">{c.faq.title}</h2>
    <div class="faq">
      {c.faq.items.map((f, i) => (
        <details open={i < 2}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

