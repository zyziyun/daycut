---
// Reelfold mark (fan of cards, on-light colours) inlined from assets/brand; the name is set in Inter as in design F.
import symbol from '../../assets/brand/symbol-on-light.svg?raw';
interface Props { idPrefix?: string; width?: number }
const { idPrefix = 'lg', width = 30 } = Astro.props;
const inner = symbol.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
// prefix ids so several marks on one page cannot clash
const sym = inner.replace(/id="([^"]+)"/g, `id="${idPrefix}-$1"`).replace(/url\(#([^)]+)\)/g, `url(#${idPrefix}-$1)`);
const h = Math.round((width * 345) / 604);
---
<svg class="mark-svg" aria-hidden="true" focusable="false" viewBox="32 27 604 345" width={width} height={h} set:html={sym} />
