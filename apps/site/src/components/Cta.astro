---
// Primary calls to action. While SITE.downloadReady is false (no macOS release yet) there is no download link:
// "Star on GitHub" becomes the primary button, "Build from source" jumps to the open-source section, and a
// "coming soon" note explains why.
import { SITE } from '../config';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const c = t(Astro.props.lang);
const ready = SITE.downloadReady;
const apple = 'M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.5.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.6-1-2.6-4.1zM13.9 5c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z';
const star = 'M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3L2.9 9.4l6.3-.9L12 2.8z';
---
<div class="cta-row">
  {ready ? (
    <a class="btn" href={SITE.downloadUrl} rel="noopener">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d={apple} /></svg>
      {c.cta.download}
    </a>
    <a class="btn btn-ghost" href={SITE.githubUrl} rel="noopener">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d={star} /></svg>
      {c.cta.star}
    </a>
  ) : (
    <a class="btn" href={SITE.githubUrl} rel="noopener">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d={star} /></svg>
      {c.cta.star}
    </a>
    <a class="btn btn-ghost" href="#oss">{c.cta.source}</a>
  )}
</div>
{!ready && (
  <p class="soon" role="note"><span class="soon-tag">{c.cta.soon}</span><span>{c.cta.soonNote}</span></p>
)}
