---
import { t, type Lang } from '../../i18n';
import { heading } from '../../lib/zhHeading';
import { img } from '../../lib/images';
import Print from '../Print.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<section class="wrap" aria-labelledby="cr-h">
  <div class="create">
    <div>
      <p class="kick">{c.create.k}</p>
      <h2 id="cr-h" set:html={heading(c.create.t, lang)} />
      <p class="lede">{c.create.l}</p>
      <p class="tag">{c.create.tag}</p>
    </div>
    <Print src={img('create', lang)} alt={c.create.alt} widths={[600, 1200]} sizes="(max-width: 900px) calc(100vw - 2 * var(--pad)), 640px" />
  </div>
</section>
