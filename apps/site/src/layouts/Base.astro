---
import '../styles/global.css';
import { SITE, discussionsUrl } from '../config';
import Logo from '../components/Logo.astro';
import { t, prefix, pathFor, LANGS, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page?: '' | 'privacy' | 'terms';
  title?: string;
  description?: string;
}
const { lang, page = '', title, description } = Astro.props;
const c = t(lang);
const home = prefix(lang) + '/';
const brand = lang === 'zh' ? `${SITE.nameZh} ${SITE.name}` : SITE.name;
const pageTitle = title ? `${title} · ${brand}` : c.meta.title;
const desc = description ?? c.meta.description;
const site = SITE.url.replace(/\/$/, '');
const HREFLANG: Record<Lang, string> = { en: 'en', zh: 'zh-CN', fr: 'fr' };
const LABEL: Record<Lang, string> = { en: 'EN', zh: '中文', fr: 'FR' };
const urlFor = (l: Lang) => `${site}${pathFor(l, page)}`;
const canonical = urlFor(lang);
const nav = [
  ['how', c.nav.how],
  ['uses', c.nav.uses],
  ['app', c.nav.app],
  ['proof', c.nav.proof],
  ['oss', c.nav.oss],
  ['faq', c.nav.faq],
] as const;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor('en')} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF6EE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/img/og.png`} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Reelfold 千剪: Describe the batch. Fold one recording into every cut, for every platform." />
    <meta name="twitter:card" content="summary_large_image" />
    {page !== '' && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip" href="#main">{c.nav.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="logo" href={home} aria-label={brand}>
          <Logo zh={lang === 'zh'} />
        </a>
        <nav class="main-nav" aria-label="primary">
          {nav.map(([id, label]) => <a href={`${home}#${id}`}>{label}</a>)}
        </nav>
        <div class="header-actions">
          <div class="lang-switch" role="group" aria-label={c.nav.langGroup}>
            {LANGS.map((l, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true">·</span>}
                <a href={pathFor(l, page)} hreflang={HREFLANG[l]} lang={HREFLANG[l]} aria-current={lang === l ? 'page' : undefined} data-keep-hash>{LABEL[l]}</a>
              </Fragment>
            ))}
          </div>
          {SITE.downloadReady ? (
            <a class="btn btn-sm" href={SITE.downloadUrl} rel="noopener">{c.cta.download}</a>
          ) : (
            <a class="btn btn-sm" href={SITE.githubUrl} rel="noopener">{c.cta.star}</a>
          )}
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p>© 2026 {brand}</p>
        <nav aria-label="footer">
          <a href={`${prefix(lang)}/privacy`}>{c.footer.privacy}</a>
          <a href={`${prefix(lang)}/terms`}>{c.footer.terms}</a>
          <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          <a href={SITE.githubUrl} rel="noopener">GitHub</a>
          <a href={discussionsUrl} rel="noopener">{c.footer.feedback}</a>
        </nav>
        <p class="muted small">{c.footer.note}</p>
      </div>
    </footer>
    <script is:inline>
      // Language switcher keeps the current section (#hash). Without JS it still opens the same page.
      document.querySelectorAll('a[data-keep-hash]').forEach(function (a) {
        a.addEventListener('click', function () { if (location.hash) a.href = a.getAttribute('href') + location.hash; });
      });
    </script>
  </body>
</html>
