---
import '../styles/global.css';
import zhFontCss from '../styles/zh-font.css?raw';
import Seo from '../components/Seo.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t, HTML_LANG, type Lang } from '../i18n';
import zhFont from '../data/zh-font.json';

interface Props {
  lang: Lang;
  /** '' = home; 'podcast-clips', 'compare/descript', 'platforms', 'privacy', ... (same id in every language) */
  page: string;
  title: string;
  description: string;
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
}
const { lang, page, title, description, jsonld, noindex } = Astro.props;
const c = t(lang);
---
<!doctype html>
<html lang={HTML_LANG[lang]} class={`lang-${lang}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {lang} {page} {title} {description} {jsonld} {noindex} ogAlt={c.meta.ogAlt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F0E8" />
    {lang === 'zh' ? (
      <>
        <link rel="preload" href={`/fonts/${zhFont.core}`} as="font" type="font/woff2" crossorigin />
        <style is:inline set:html={zhFontCss} />
      </>
    ) : (
      <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    )}
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SiteNav {lang} {page} />
    <main id="main"><slot /></main>
    <SiteFooter {lang} {page} />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var nav = document.querySelector('.nav');
        addEventListener('scroll', function () { nav.classList.toggle('scrolled', scrollY > 8); }, { passive: true });
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } });
          }, { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        } else document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
        // the language switch keeps the current section (#hash); without JS it still opens the same page
        document.querySelectorAll('a[data-keep-hash]').forEach(function (a) {
          a.addEventListener('click', function () { if (location.hash) a.href = a.getAttribute('href') + location.hash; });
        });
        var ls = document.querySelector('.langsel');
        document.addEventListener('click', function (e) { if (ls && ls.open && !ls.contains(e.target)) ls.open = false; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ls && ls.open) { ls.open = false; ls.querySelector('summary').focus(); } });
      })();
    </script>
  </body>
</html>
