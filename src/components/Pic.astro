---
// Responsive <picture> for the pre-optimised images in public/img (see scripts/optimize-images.sh).
interface Props {
  name: string;          // base name, e.g. 'talkinghead'
  widths?: number[];     // available widths; omit for single-size images (frames, strip)
  w: number;             // intrinsic width (for CLS-free layout)
  h: number;             // intrinsic height
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { name, widths, w, h, alt, sizes = '100vw', eager = false, class: cls } = Astro.props;
const set = (ext: string) =>
  widths ? widths.map((x) => `/img/${name}-${x}.${ext} ${x}w`).join(', ') : `/img/${name}.${ext}`;
const fallback = widths ? `/img/${name}-${widths[widths.length - 1]}.webp` : `/img/${name}.webp`;
---
<picture class={cls}>
  <source type="image/avif" srcset={set('avif')} sizes={widths ? sizes : undefined} />
  <img
    src={fallback}
    srcset={widths ? set('webp') : undefined}
    sizes={widths ? sizes : undefined}
    width={w}
    height={h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>
