---
import Pic from './Pic.astro';
import { SITE } from '../config';
import { t, prefix, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = prefix(lang);

const SHEETS: Record<string, { w: number; h: number }> = {
  'longform-slices': { w: 1600, h: 712 },
  talkinghead: { w: 1600, h: 754 },
  'explainer-vertical': { w: 1600, h: 996 },
};
const [wide, ...pair] = c.proof.sheets;

const formOn = SITE.formEndpoint.trim() !== '';
const mailto = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(c.form.mailSubject)}&body=${encodeURIComponent(c.form.mailBody)}`;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 id="hero-title">{c.hero.titleA}<br /><mark>{c.hero.titleB}</mark></h1>
      <p class="lede">{c.hero.sub}</p>
      <div class="cta-row">
        <a class="btn" href="#apply">{c.hero.ctaPrimary}</a>
        <a class="btn btn-ghost" href="#proof">{c.hero.ctaSecondary}</a>
      </div>
      <ul class="ticks">
        {c.hero.points.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="hero-visual" aria-hidden="false">
      <div class="phones">
        {[1, 2, 5].map((n, i) => (
          <figure class={`phone phone-${i + 1}`}>
            <Pic name={`frame-${n}`} w={196} h={256} alt={c.hero.frameAlts[i]} eager />
          </figure>
        ))}
      </div>
      <span class="sticker s-a">{c.hero.stickerA}</span>
      <span class="sticker s-b"><span class="dot dot-green" aria-hidden="true"></span>{c.hero.stickerB}</span>
      <span class="sticker s-c">{c.hero.stickerC}</span>
    </div>
  </div>
</section>

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <p class="kicker">{c.how.kicker}</p>
    <h2 id="how-title">{c.how.title}</h2>
    <ol class="steps">
      {c.how.steps.map((s, i) => (
        <li class="card step">
          <span class="step-num" aria-hidden="true">{pad(i + 1)}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="platforms">
      <span class="muted small">{c.how.platformsLabel}</span>
      <ul class="chips">
        {c.how.platforms.map((x) => <li class="chip">{x}</li>)}
      </ul>
    </div>
  </div>
</section>

<section id="proof" class="section section-paper" aria-labelledby="proof-title">
  <div class="wrap">
    <p class="kicker">{c.proof.kicker}</p>
    <h2 id="proof-title">{c.proof.title}</h2>
    <p class="lede">{c.proof.lede}</p>
    <dl class="stats">
      {c.proof.stats.map((s) => (
        <div class="card stat">
          <dt>{s.label}</dt>
          <dd class="stat-value">{s.value}</dd>
          <dd class="stat-note">{s.note}</dd>
        </div>
      ))}
    </dl>
    <div class="card caveats">
      <h3>{c.proof.caveatsTitle}</h3>
      <ul>
        {c.proof.caveats.map((x) => <li>{x}</li>)}
      </ul>
    </div>

    <figure class="strip">
      <ul class="frames">
        {[1, 2, 3, 4, 5, 6].map((n) => (
          <li><Pic name={`frame-${n}`} w={196} h={256} alt={c.proof.stripAlts[n - 1]} /></li>
        ))}
      </ul>
      <figcaption class="small muted">{c.proof.stripCaption}</figcaption>
    </figure>

    <figure class="sheet sheet-wide">
      <Pic name={wide.img} widths={[800, 1600]} w={SHEETS[wide.img].w} h={SHEETS[wide.img].h} alt={wide.alt} sizes="(min-width: 1180px) 1120px, 100vw" />
      <figcaption class="small muted">{wide.caption}</figcaption>
    </figure>
    <div class="sheet-pair">
      {pair.map((s) => (
        <figure class="sheet">
          <Pic name={s.img} widths={[800, 1600]} w={SHEETS[s.img].w} h={SHEETS[s.img].h} alt={s.alt} sizes="(min-width: 900px) 560px, 100vw" />
          <figcaption class="small muted">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="deliverables" class="section" aria-labelledby="deliv-title">
  <div class="wrap">
    <p class="kicker">{c.deliverables.kicker}</p>
    <h2 id="deliv-title">{c.deliverables.title}</h2>
    <ul class="grid-3">
      {c.deliverables.items.map((d) => (
        <li class="card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="partner" class="section section-red" aria-labelledby="partner-title">
  <div class="wrap">
    <p class="kicker">{c.partner.kicker}</p>
    <h2 id="partner-title"><mark>{c.partner.title}</mark></h2>
    <p class="lede">{c.partner.lede}</p>
    <div class="partner-grid">
      <div class="card">
        <h3>{c.partner.getTitle}</h3>
        <ul class="ticks">
          {c.partner.get.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="card">
        <h3>{c.partner.giveTitle}</h3>
        <ol class="numbered">
          {c.partner.give.map((x) => <li>{x}</li>)}
        </ol>
      </div>
    </div>
    <p class="small muted partner-priority">{c.partner.priority}</p>

    <div id="apply" class="card form-card">
      <h3>{c.form.title}</h3>
      {!formOn && (
        <div class="notice" role="note">
          <p><strong>{c.form.offTitle}</strong></p>
          <p>{c.form.offBody}</p>
          <a class="btn" href={mailto}>{c.form.offButton}</a>
          <p class="small muted">{SITE.contactEmail}</p>
        </div>
      )}
      <form action={formOn ? SITE.formEndpoint : undefined} method="post" accept-charset="UTF-8" class:list={['apply-form', { off: !formOn }]}>
        <fieldset disabled={!formOn}>
          <legend class="sr-only">{c.form.title}</legend>
          <input type="hidden" name="lang" value={lang} />
          <div class="hp" aria-hidden="true">
            <label>Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="field-row">
            <label class="field">
              <span>{c.form.name} <em>*</em></span>
              <input name="name" type="text" required autocomplete="name" maxlength="80" />
            </label>
            <label class="field">
              <span>{c.form.contact} <em>*</em></span>
              <input name="contact" type="text" required maxlength="120" />
            </label>
          </div>
          <label class="field">
            <span>{c.form.profile} <em>*</em></span>
            <input name="profile" type="url" required inputmode="url" placeholder="https://" maxlength="300" />
          </label>
          <div class="field-row">
            <label class="field">
              <span>{c.form.type}</span>
              <select name="content_type">
                {c.form.typeOptions.map((o) => <option>{o}</option>)}
              </select>
            </label>
            <label class="field">
              <span>{c.form.hours}</span>
              <select name="hours">
                {c.form.hoursOptions.map((o) => <option>{o}</option>)}
              </select>
            </label>
          </div>
          <fieldset class="field checks">
            <legend>{c.form.platforms}</legend>
            {c.form.platformOptions.map((o) => (
              <label class="check"><input type="checkbox" name="platforms" value={o} /> {o}</label>
            ))}
          </fieldset>
          <label class="field">
            <span>{c.form.sample}</span>
            <input name="sample" type="text" maxlength="300" />
          </label>
          <label class="field">
            <span>{c.form.notes}</span>
            <textarea name="notes" rows="3" maxlength="2000"></textarea>
          </label>
          <div class="consents">
            <label class="check"><input type="checkbox" name="consent_rights" required /> {c.form.consentRights} <em>*</em></label>
            <label class="check"><input type="checkbox" name="consent_terms" required /> {c.form.consentTerms} <em>*</em></label>
            <label class="check"><input type="checkbox" name="consent_privacy" required /> <span>{c.form.consentPrivacy} (<a href={`${p}/privacy`}>{c.form.privacyLink}</a>)</span> <em>*</em></label>
          </div>
          <button class="btn" type="submit">{c.form.submit}</button>
          <p class="small muted">* {c.form.required}. {c.form.note}</p>
        </fieldset>
      </form>
    </div>
  </div>
</section>

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="wrap">
    <p class="kicker">{c.pricing.kicker}</p>
    <h2 id="pricing-title">{c.pricing.title} <span class="badge">{c.pricing.badge}</span></h2>
    <p class="lede">{c.pricing.lede}</p>
    <ul class="grid-3 plans">
      {c.pricing.plans.map((pl) => (
        <li class="card plan">
          <h3>{pl.name}</h3>
          <p class="price"><span class="amount">{pl.price}</span> <span class="unit">{pl.unit}</span></p>
          <ul class="ticks">
            {pl.items.map((x) => <li>{x}</li>)}
          </ul>
        </li>
      ))}
    </ul>
    <p class="small muted">{c.pricing.currency}</p>
  </div>
</section>

<section id="desktop" class="section section-paper" aria-labelledby="desktop-title">
  <div class="wrap split">
    <div>
      <p class="kicker">{c.desktop.kicker}</p>
      <h2 id="desktop-title">{c.desktop.title}</h2>
      <p class="lede">{c.desktop.lede}</p>
      <div class="cta-row">
        <a class="btn btn-dark" href={SITE.downloadUrl} rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.8 1.2 1.8 2.6 3.1 2.5 1.3-.1 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.5.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.6-1-2.6-4.1zM13.9 5c.7-.8 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"/></svg>
          {c.desktop.mac}
        </a>
        <a class="btn btn-dark" href={SITE.downloadUrl} rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M3 5.1 10.4 4v7.1H3V5.1zm0 13.8 7.4 1.1v-7H3v5.9zM11.3 3.9 21 2.5v8.6h-9.7V3.9zm0 16.2 9.7 1.4v-8.5h-9.7v7.1z"/></svg>
          {c.desktop.win}
        </a>
      </div>
      <p class="small muted">{c.desktop.note}</p>
    </div>
    <figure class="board" aria-label={c.desktop.board.caption}>
      <div class="board-cols">
        {c.desktop.board.cols.map((col, i) => (
          <div class="board-col">
            <span class="board-head">{col}</span>
            <div class="board-card">
              <span class="thumb" style={`background-image:url(/img/frame-${(i % 3) === 0 ? 2 : (i % 3) === 1 ? 1 : 5}.webp)`}></span>
              <span class="board-title">{c.desktop.board.cards[i]}</span>
              {i === 2 ? (
                <span class="pill pill-red"><span class="dot dot-red" aria-hidden="true"></span>{c.desktop.board.red}</span>
              ) : i >= 3 ? (
                <span class="pill"><span class="dot dot-green" aria-hidden="true"></span>{c.desktop.board.green}</span>
              ) : null}
            </div>
          </div>
        ))}
      </div>
      <figcaption class="small muted">{c.desktop.board.caption}</figcaption>
    </figure>
  </div>
</section>

<section id="oss" class="section" aria-labelledby="oss-title">
  <div class="wrap split oss">
    <div>
      <p class="kicker">{c.oss.kicker}</p>
      <h2 id="oss-title">{c.oss.title}</h2>
      <p class="lede">{c.oss.lede}</p>
      <p class="small muted">{c.oss.tested}</p>
      <a class="btn btn-ghost" href={SITE.githubUrl} rel="noopener">{c.oss.button} · github.com/zyziyun/video-studio</a>
    </div>
    <pre class="code" aria-label="install"><code><span class="muted"># Claude Code skill · MIT</span>
git clone {SITE.githubUrl} \
  ~/.claude/skills/video-studio
~/.claude/skills/video-studio/install.sh</code></pre>
  </div>
</section>

<section id="faq" class="section section-paper" aria-labelledby="faq-title">
  <div class="wrap narrow">
    <p class="kicker">{c.faq.kicker}</p>
    <h2 id="faq-title">{c.faq.title}</h2>
    <div class="faq">
      {c.faq.items.map((f, i) => (
        <details open={i < 2}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap narrow contact">
    <p class="kicker">{c.contact.kicker}</p>
    <h2 id="contact-title">{c.contact.title}</h2>
    <p class="lede">{c.contact.body}</p>
    <div class="cta-row">
      <a class="btn" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      <a class="btn btn-ghost" href={`${SITE.githubUrl}/issues`} rel="noopener">{c.contact.github}</a>
    </div>
  </div>
</section>
