{
  "name": "video-studio-monorepo",
  "private": true,
  "description": "Reelfold (千剪): the open-source video-studio skill + engine (repo root), the Reelfold desktop app (apps/desk), the website (apps/site) and the docs (apps/docs).",
  "license": "MIT",
  "homepage": "https://reelfold.com",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desk",
    "desk": "npm run dev -w apps/desk",
    "site": "npm run dev -w apps/site",
    "lint": "npm run lint -w apps/desk",
    "test": "npm run test -w apps/desk",
    "build:site": "npm run build -w apps/site",
    "docs": "npm run dev -w apps/docs",
    "build:docs": "npm run build -w apps/docs",
    "build:web": "scripts/build-web.sh",
    "check": "python3 scripts/check_skill.py",
    "version:bump": "npm version --no-git-tag-version --workspace apps/desk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyziyun/reelfold.git"
  },
  "engines": {
    "node": ">=22"
  }
}
